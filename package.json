{
	"name": "skladan",
	"version": "1.0.0",
	"description": "Skladan backend — складская система: товары, заказы, закупки, инвентаризация.",
	"author": {
		"name": "Lord_mahor",
		"url": "https://t.me/Lord_mahor"
	},
	"private": true,
	"license": "Apache-2.0",
	"scripts": {
		"prebuild": "rimraf dist",
		"build": "nest build",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"start": "nest start",
		"dev": "nest start --watch",
		"debug": "nest start --debug --watch",
		"prod": "node dist/main",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"test": "jest --config jest.config.ts",
		"test:watch": "jest --config jest.config.ts --watch",
		"test:cov": "jest --config jest.config.ts --coverage",
		"migrate:up": "node dist/migrations/v2.0.0/cli up",
		"migrate:dry-run": "node dist/migrations/v2.0.0/cli up --dry-run",
		"migrate:status": "node dist/migrations/v2.0.0/cli status",
		"migrate:rollback": "node dist/migrations/v2.0.0/cli rollback"
	},
	"dependencies": {
		"@nestjs/axios": "^4.0.0",
		"@nestjs/common": "^11.0.1",
		"@nestjs/config": "^4.0.0",
		"@nestjs/core": "^11.0.1",
		"@nestjs/jwt": "^11.0.0",
		"@nestjs/passport": "^11.0.3",
		"@nestjs/platform-express": "^11.0.10",
		"@nestjs/schedule": "^6.1.3",
		"@nestjs/throttler": "5",
		"@typegoose/typegoose": "^12.10.1",
		"bcryptjs": "^2.4.3",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.1",
		"cors": "^2.8.5",
		"https-proxy-agent": "^7.0.6",
		"mongoose": "^8.9.5",
		"nestjs-typegoose": "^7.1.38",
		"passport": "^0.7.0",
		"passport-jwt": "^4.0.1",
		"prom-client": "^15.1.3",
		"reflect-metadata": "^0.2.2",
		"rimraf": "^6.0.1",
		"web-push": "^3.6.7"
	},
	"devDependencies": {
		"@nestjs/cli": "^10.4.9",
		"@nestjs/schematics": "^11.0.0",
		"@nestjs/testing": "^11.0.1",
		"@types/bcryptjs": "^2.4.6",
		"@types/express": "^5.0.0",
		"@types/jest": "^29.5.14",
		"@types/mongoose": "^5.11.97",
		"@types/multer": "^1.4.12",
		"@types/node": "^22.10.7",
		"@types/passport-jwt": "^4.0.1",
		"@types/supertest": "^6.0.2",
		"@typescript-eslint/eslint-plugin": "^8.20.0",
		"@typescript-eslint/parser": "^8.20.0",
		"eslint": "9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-prettier": "^5.2.3",
		"jest": "^29.7.0",
		"prettier": "^3.4.2",
		"source-map-support": "^0.5.20",
		"supertest": "^7.0.0",
		"ts-jest": "^29.2.6",
		"ts-loader": "^9.5.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "4.2.0",
		"typescript": "^5.7.3"
	}
}
